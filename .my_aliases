# ---- Git workflow ----
alias gs='git status -sb'                             ## short branch status
alias gca='git commit --amend --no-edit'              ## amend without editing message
alias gcan='git commit --amend --no-edit --no-verify' ## amend without editing message, skip hooks
alias gcm='git commit -m'                             ## commit with message
alias gcmn='git commit --no-verify -m'                ## commit with message, skip hooks
alias gcb='git checkout -b'                           ## create and switch to new branch
alias gco='git checkout'                              ## checkout branch or file
alias gpl='git pull --rebase'                         ## pull with rebase
alias grb='git rebase'                                ## rebase onto <branch>
alias grbi='git rebase -i'                            ## interactive rebase
alias grbc='git rebase --continue'                    ## continue rebase after resolving conflicts
alias grba='git rebase --abort'                       ## abort in-progress rebase
alias gps='git push'                                  ## push
alias gpsn='git push --no-verify'                     ## push, skip hooks
alias gpsf='git push --force-with-lease'              ## safe force push
alias gpsfn='git push --force-with-lease --no-verify' ## safe force push, skip hooks
alias gst='git stash'                                 ## stash changes
alias gstp='git stash pop'                            ## pop last stash
alias glg='git log --oneline --graph --decorate -20'  ## graph of last 20 commits
alias gd='git diff'                                   ## diff unstaged
alias gds='git diff --staged'                         ## diff staged
alias gbr='git branch'                                ## list branches

gbl() {  ## recent branches as a table (gbl [count], default 20)
  {
    printf 'BRANCH\tLAST COMMIT\tAUTHOR\n'
    git for-each-ref --count="${1:-20}" --sort=-committerdate refs/heads/ \
      --format='%(refname:short)%09%(committerdate:relative)%09%(authorname)'
  } | column -t -s $'\t'
}

# ---- npm / node / package managers ----
alias ni='npm install'              ## npm install
alias nid='npm install --save-dev'  ## npm install as dev dependency
alias nr='npm run'                  ## npm run <script>
alias nrd='npm run dev'             ## npm run dev
alias nrb='npm run build'           ## npm run build
alias nrt='npm run test'            ## npm run test
alias pni='pnpm install'            ## pnpm install
alias pnd='pnpm dev'                ## pnpm dev
alias pnb='pnpm build'              ## pnpm build
alias bi='bun install'              ## bun install
alias bd='bun dev'                  ## bun dev
alias bb='bun run build'            ## bun run build

# ---- Directory navigation ----
alias ..='cd ..'           ## up one directory
alias ...='cd ../..'       ## up two directories
alias ....='cd ../../..'   ## up three directories
alias .....='cd ../../../..'  ## up four directories
alias ll='ls -lah'         ## long list including hidden files
alias la='ls -A'           ## list all except . and ..
alias l='ls -CF'           ## compact listing

# ---- Misc ----
alias reload='source ~/.zshrc'         ## re-source ~/.zshrc
alias path='echo -e ${PATH//:/\\n}'    ## print PATH one entry per line
alias cdsp='claude --dangerously-skip-permissions'  ## launch Claude Code skipping permission prompts

fckoff() {  ## kill whatever is listening on <port> (fckoff <port>)
  if [ -z "$1" ]; then
    echo "Usage: fckoff <port>" >&2
    return 1
  fi
  local pids
  pids=$(lsof -ti tcp:"$1")
  if [ -z "$pids" ]; then
    echo "Nothing listening on port $1"
    return 0
  fi
  echo "Killing PID(s) on port $1: $pids"
  echo "$pids" | xargs kill -9
}

hlp() {  ## show descriptions for aliases/functions (hlp [--section|<name>])
  local filter="" one_name=""
  if [ -n "$1" ]; then
    case "$1" in
      --*) filter="${1#--}" ;;
      *)   one_name="$1" ;;
    esac
  fi

  local files=("$HOME/.my_aliases" "$HOME/.my_aliases.machine" "$HOME/.ai/aic.sh") existing=()
  local f
  for f in "${files[@]}"; do [ -f "$f" ] && existing+=("$f"); done

  awk -v filter="$filter" -v one_name="$one_name" '
    /^# ---- .+ ----[[:space:]]*$/ {
      line = $0
      sub(/^# ---- /, "", line)
      sub(/ ----[[:space:]]*$/, "", line)
      section = line
      next
    }
    /##/ {
      name = ""
      if (match($0, /^alias[ \t]+[^=]+=/)) {
        s = substr($0, RSTART, RLENGTH)
        sub(/^alias[ \t]+/, "", s)
        sub(/=$/, "", s)
        name = s
      } else if (match($0, /^[A-Za-z_][A-Za-z0-9_]*\(\)/)) {
        s = substr($0, RSTART, RLENGTH)
        sub(/\(\)/, "", s)
        name = s
      }
      if (name == "") next

      idx = index($0, "##")
      desc = substr($0, idx + 2)
      sub(/^[ \t]+/, "", desc)
      sub(/[ \t]+$/, "", desc)

      if (one_name != "" && name != one_name) next
      if (filter != "" && index(tolower(section), tolower(filter)) == 0) next

      if (section != last_section) {
        if (last_section != "") print ""
        print "# " section
        last_section = section
      }
      printf "  %s\t%s\n", name, desc
    }
  ' "${existing[@]}" | column -t -s $'\t'
}

# AI library (aic command) — definition lives in ~/.ai/aic.sh, which also
# owns its own `# ---- AI library ----` section so hlp picks it up.
[ -f "$HOME/.ai/aic.sh" ] && source "$HOME/.ai/aic.sh"

# ---- Machine-specific aliases ----
# Aliases tied to this machine's layout live in .my_aliases.machine (tracked, sourced here).
[ -f "$HOME/.my_aliases.machine" ] && source "$HOME/.my_aliases.machine"
